# FitTrack Environment Configuration

# Flask Secret Key for sessions and CSRF
SECRET_KEY=fittrack_super_secure_secret_key_change_in_production_2026

# Database Configuration
# Default: Local SQLite (runs immediately without external service setup)
DATABASE_URL=sqlite:///fittrack.db

# For MySQL Database (BTech evaluation / production):
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/fittrack_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
